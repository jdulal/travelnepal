# Nepal Travel environment
# Local XAMPP MariaDB defaults
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=root
DB_PASSWORD=
DB_NAME=nepal_travel
DB_CONNECTION_LIMIT=10

# Session signing secret — change in production (min 32 chars)
SESSION_SECRET=nepal-travel-dev-secret-change-me-please-2026

# Optional AI provider (OpenAI-compatible). Leave blank to use the built-in
# deterministic planner/assistant that works fully offline.
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=gpt-4o-mini

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000
